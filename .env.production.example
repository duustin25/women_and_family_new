APP_NAME="Barangay 183 WFP System"
APP_ENV=production
APP_KEY=base64:your-production-app-key-here
APP_DEBUG=false
APP_URL=https://your-coolify-domain.com
PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Connection (MySQL on Coolify)
DB_CONNECTION=mysql
DB_URL=
DB_HOST=your-db-host
DB_PORT=3306
DB_DATABASE=default
DB_USERNAME=mysql
DB_PASSWORD=your-db-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Queue Connection (database for production with supervisord queue-worker)
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail Configuration (REQUIRED for Live Real-Time & Bulk Email Delivery on Coolify / VPS)
# IMPORTANT: Provide Gmail SMTP credentials or Mailgun/Postmark.
# Without these, Laravel defaults to 'log' and will NOT send emails to recipients!
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-organization-email@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="barangay183women&family@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AUTORUN_MIGRATIONS=true
AUTORUN_SEED=false

VITE_APP_NAME="${APP_NAME}"
